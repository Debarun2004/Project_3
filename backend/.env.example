# Copy this file to .env and enter your MySQL password locally.
DATA_SOURCE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=prithibiroute_app
MYSQL_PASSWORD=replace_with_your_local_mysql_password
MYSQL_DATABASE=prithibiroute
MYSQL_SEED_DEMO_DATA=true
# Sites allowed to call this API from a browser (comma-separated, or * for any).
CORS_ORIGINS=*
